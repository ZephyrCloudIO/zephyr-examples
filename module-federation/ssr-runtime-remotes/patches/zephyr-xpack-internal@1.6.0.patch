diff --git a/dist/xpack-extract/xpack-build-coordinator.js b/dist/xpack-extract/xpack-build-coordinator.js
index f7d8f21811a6f46edf6442a1802b3fad4cb27f83..6e47af012274a528a4188ebac4ec57f3feab98b7 100644
--- a/dist/xpack-extract/xpack-build-coordinator.js
+++ b/dist/xpack-extract/xpack-build-coordinator.js
@@ -146,7 +146,24 @@ class XPackBuildCoordinator {
             applicationUid: engine.application_uid,
             prepare: ({ generation })=>this.prepareLogicalGeneration(generation),
             publish: async (publication)=>{
-                const metadata = publication.contributions.map((contribution)=>contribution.data).filter((item)=>!!item);
+                // A server compiler that builds the Node copy of a container a client
+                // compiler already describes (Module Federation SSR) is not a conflict:
+                // the snapshot describes the browser container, and the Node build is
+                // served from the same deployment.
+                const contributions = publication.contributions.filter((contribution)=>!!contribution.data);
+                const isServer = (contribution)=>'server' === contribution.role;
+                const clientContainers = new Set(contributions.filter((contribution)=>!isServer(contribution)).flatMap((contribution)=>[
+                        ...(contribution.data.mfConfigs ?? []).map((config)=>config.name),
+                        ...(contribution.data.buildStats?.federation ?? []).map((entry)=>entry.name)
+                    ]).filter(Boolean));
+                const metadata = contributions.map((contribution)=>isServer(contribution) ? {
+                        ...contribution.data,
+                        mfConfigs: contribution.data.mfConfigs?.filter((config)=>!clientContainers.has(config.name)),
+                        buildStats: {
+                            ...contribution.data.buildStats,
+                            federation: contribution.data.buildStats?.federation?.filter((entry)=>!clientContainers.has(entry.name))
+                        }
+                    } : contribution.data);
                 const entrypoint = 'ssr' === options.snapshotType ? resolveServerEntrypoint(publication.assetsMap, options.entrypoint) : options.entrypoint;
                 if ('ssr' === options.snapshotType && !entrypoint) throw xpackError('Could not infer the server entrypoint for a coordinated xpack build');
                 if ('ssr' === options.snapshotType && entrypoint && !Object.values(publication.assetsMap).some((asset)=>asset.path === entrypoint)) throw xpackError(`Coordinated xpack server entrypoint "${entrypoint}" was not emitted`);
