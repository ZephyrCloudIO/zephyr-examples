# Which product card build most visitors get: a Zephyr environment, tag, or
# semver range. Leave empty to render the build this host was built with.
REMOTE_SELECTOR=
# Optional canary: a second selector, and the share of visitors (0-100) who get it.
CANDIDATE_SELECTOR=
CANDIDATE_PERCENT=0
# Let the `x-zephyr-preview: candidate` header force the candidate, for testing
# it before it gets traffic.
ALLOW_PREVIEW=false
