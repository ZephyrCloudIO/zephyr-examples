# NEAR account that will sign the deploy (must be in the DeployRegistry authorized set)
NEAR_ACCOUNT_ID=alice.testnet
# Ed25519 private key for that account — starts with "ed25519:"
NEAR_PRIVATE_KEY=ed25519:...
# "testnet" or "mainnet"
NEAR_NETWORK=testnet

# DeployRegistry NEAR contract account id (deployed via `pnpm deploy:contract`)
DEPLOY_REGISTRY_CONTRACT=zephyr-registry.alice.testnet

# OutLayer project id for the zephyr-auth-gate WASM (owner/name)
OUTLAYER_PROJECT_ID=alice.testnet/zephyr-auth-gate
# NEAR account that owns the OutLayer ZE_SERVER_TOKEN secret
OUTLAYER_SECRET_OWNER=alice.testnet