# NEAR account that signs the deploy (must be in the DeployRegistry authorized set)
NEAR_ACCOUNT_ID=alice.testnet
# Ed25519 private key for that account — starts with "ed25519:"
NEAR_PRIVATE_KEY=ed25519:...
# "testnet" or "mainnet"
NEAR_NETWORK=testnet

# DeployRegistry NEAR contract account id (deploy with `pnpm deploy:contract`)
DEPLOY_REGISTRY_CONTRACT=zephyr-registry.alice.testnet

# URL of the near-zephyr-proxy Hono server
ZEPHYR_AUTH_PROXY=http://localhost:3000
